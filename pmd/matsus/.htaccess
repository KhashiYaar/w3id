# .htaccess for Platform MaterialDigital vocabularies - MatSus
# Canonical namespace: https://w3id.org/pmd/matsus/
# Maintainer: Dr. Khashayar Razghandi [@KhashiYaar]

RewriteEngine On

# Current development publication
SetEnvIf Request_URI ^/pmd/matsus/?$                            ONT_BASE=https://materialdigital.github.io/material-sustainability-application-ontology ONT_DOC=/dev/doc
SetEnvIf Request_URI ^/pmd/matsus/dev/?$                        ONT_BASE=https://materialdigital.github.io/material-sustainability-application-ontology ONT_DOC=/dev/doc
SetEnvIf Request_URI ^/pmd/matsus/(MATSUS_[0-9]+)/?$            ONT_BASE=https://materialdigital.github.io/material-sustainability-application-ontology ONT_DOC=/dev/doc ONT_ANCHOR=$1
SetEnvIf Request_URI ^/pmd/matsus/dev/(MATSUS_[0-9]+)/?$        ONT_BASE=https://materialdigital.github.io/material-sustainability-application-ontology ONT_DOC=/dev/doc ONT_ANCHOR=$1

# Turtle
RewriteCond %{ENV:ONT_BASE} !^$
RewriteCond %{HTTP_ACCEPT} text/turtle
RewriteRule ^(.*)$ %{ENV:ONT_BASE}%{ENV:ONT_DOC}/ontology.ttl [R=303,L]

# JSON-LD
RewriteCond %{ENV:ONT_BASE} !^$
RewriteCond %{HTTP_ACCEPT} application/ld\+json
RewriteRule ^(.*)$ %{ENV:ONT_BASE}%{ENV:ONT_DOC}/ontology.jsonld [R=303,L]

# RDF/XML
RewriteCond %{ENV:ONT_BASE} !^$
RewriteCond %{HTTP_ACCEPT} application/rdf\+xml
RewriteRule ^(.*)$ %{ENV:ONT_BASE}%{ENV:ONT_DOC}/ontology.owl [R=303,L]

# N-Triples
RewriteCond %{ENV:ONT_BASE} !^$
RewriteCond %{HTTP_ACCEPT} application/n-triples
RewriteRule ^(.*)$ %{ENV:ONT_BASE}%{ENV:ONT_DOC}/ontology.nt [R=303,L]

# HTML
RewriteCond %{ENV:ONT_BASE} !^$
RewriteCond %{HTTP_ACCEPT} text/html [OR]
RewriteCond %{HTTP_ACCEPT} application/xhtml\+xml
RewriteRule ^(.*)$ %{ENV:ONT_BASE}%{ENV:ONT_DOC}/index-en.html#%{ENV:ONT_ANCHOR} [R=303,L,NE]

# Default: human-readable documentation
RewriteCond %{ENV:ONT_BASE} !^$
RewriteRule ^(.*)$ %{ENV:ONT_BASE}%{ENV:ONT_DOC}/index-en.html#%{ENV:ONT_ANCHOR} [R=303,L,NE]
